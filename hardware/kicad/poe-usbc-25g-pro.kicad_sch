  (text "Critical nets:\nPOE_VRAW, POE_VFWD, BUS_24V, BUS_28V, VBUS_SRC\nSS_TX/RX pairs, USB_CC1/2\nISO_I2C_* crossing barrier only" (at 22.0 103.0 0)
    (effects (font (size 1.35 1.35) (thickness 0.2)))
    (uuid "b5630e32-2f5e-42ea-8340-b8d6a6968521"))
  (text "Critical layout notes:\n1. Keep primary and secondary grounds split by barrier.\n2. Reserve heatsink coupling for Q105, converter FETs, inductor.\n3. Route SS_* as controlled impedance differential pairs.\n4. Do not place noisy switch nodes under USB or MCU region.\n5. Passive-mode gate logic must default disabled." (at 118.0 103.0 0)
    (effects (font (size 1.35 1.35) (thickness 0.2)))
    (uuid "8ef2cf69-f1b6-4db2-8d42-d170ad3164f4"))
